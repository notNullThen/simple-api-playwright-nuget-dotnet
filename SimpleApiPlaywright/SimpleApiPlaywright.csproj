<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SimpleApiPlaywright</PackageId>
    <Version>1.2.1</Version>
    <Authors>Eugene</Authors>
    <Description>Playwright-based API client framework.</Description>
    <PackageReleaseNotes>Updated Microsoft.Playwright to 1.63.0.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/notNullThen/simple-api-playwright-nuget-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
